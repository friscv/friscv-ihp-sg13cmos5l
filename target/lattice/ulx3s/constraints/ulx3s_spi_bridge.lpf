BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

# Either pin of a J1 pair
LOCATE COMP "gpi[0]" SITE "B11";
LOCATE COMP "gni[0]" SITE "C11";
LOCATE COMP "gpi[1]" SITE "A10";
LOCATE COMP "gni[1]" SITE "A11";
LOCATE COMP "gpi[2]" SITE "A9";
LOCATE COMP "gni[2]" SITE "B10";
LOCATE COMP "gp3"    SITE "B9";
LOCATE COMP "gn3"    SITE "C10";
LOCATE COMP "gp4"    SITE "A7";
LOCATE COMP "gn4"    SITE "A8";
IOBUF  PORT "gpi[0]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF  PORT "gni[0]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF  PORT "gpi[1]" PULLMODE=UP   IO_TYPE=LVCMOS33;
IOBUF  PORT "gni[1]" PULLMODE=UP   IO_TYPE=LVCMOS33;
IOBUF  PORT "gpi[2]" PULLMODE=UP   IO_TYPE=LVCMOS33;
IOBUF  PORT "gni[2]" PULLMODE=UP   IO_TYPE=LVCMOS33;
IOBUF  PORT "gp3"    PULLMODE=UP   IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF  PORT "gn3"    PULLMODE=UP   IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF  PORT "gp4"    PULLMODE=UP   IO_TYPE=LVCMOS33;
IOBUF  PORT "gn4"    PULLMODE=UP   IO_TYPE=LVCMOS33;

# microSD
LOCATE COMP "sd_clk" SITE "H2";
LOCATE COMP "sd_cmd" SITE "J1";
LOCATE COMP "sd_d0"  SITE "J3";
LOCATE COMP "sd_d3"  SITE "K2";
IOBUF  PORT "sd_clk" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "sd_cmd" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "sd_d0"  PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF  PORT "sd_d3"  PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;

# Config flash, clock through USRMCLK
LOCATE COMP "flash_csn"   SITE "R2";
LOCATE COMP "flash_mosi"  SITE "W2";
LOCATE COMP "flash_miso"  SITE "V2";
LOCATE COMP "flash_wpn"   SITE "Y2";
LOCATE COMP "flash_holdn" SITE "W1";
IOBUF  PORT "flash_csn"   PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "flash_mosi"  PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "flash_miso"  PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF  PORT "flash_wpn"   PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "flash_holdn" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;

# ESP32 enable
LOCATE COMP "wifi_en" SITE "F1";
IOBUF  PORT "wifi_en" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
